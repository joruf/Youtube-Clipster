[Desktop Entry]
Version=1.0
Type=Application
Name=YouTube Clipster
GenericName=Clipboard video downloader
Comment=Download YouTube videos or audio as soon as a link is copied
Comment[de]=YouTube-Videos oder -Audio laden, sobald ein Link kopiert wird
# %k is the path of this file, so the program beside it is the one that starts -- wherever the
# folder was copied to. The same path repairs Icon= in place: a .desktop file cannot point at its
# icon with a relative path (the spec reads one as a theme name), so the launcher writes the
# absolute path of the icon next to it whenever the folder has moved.
Exec=/bin/bash -c "s=\\$(readlink -f \\"\\$0\\"); d=\\${s%%/*}; i=\\$d/assets/icons/youtube-clipster.svg; grep -qxF \\"Icon=\\$i\\" \\"\\$s\\" || { I=\\$i awk '/^Icon=/{print \\"Icon=\\" ENVIRON[\\"I\\"]; next}1' \\"\\$s\\" > \\"\\$s.new\\" && mv -f \\"\\$s.new\\" \\"\\$s\\"; }; cd \\"\\$d\\" && exec python3 ./run.py" %k
Icon=/home/joruf/Applications/youtube-clipster/assets/icons/youtube-clipster.svg
Terminal=false
Categories=AudioVideo;Network;Utility;
Keywords=youtube;download;mp3;mp4;clipboard;Zwischenablage;
StartupNotify=false
