# Copy to scripts/adb-phones.env (gitignored) and adjust.
# Once per phone after USB/wireless pairing:  adb -s <device> tcpip 5555
#
# Profile is chosen from this PC's subnet, or set ADB_PHONES_PROFILE=home|away|all.

# Home (subnet 192.168.178.*)
ADB_SUBNET_home=192.168.178.
ADB_PHONES_home="192.168.178.22:5555 192.168.178.50:5555"

# Away / other Wi-Fi (subnet 192.168.198.*) — phone IPs change per network
ADB_SUBNET_away=192.168.198.
ADB_PHONES_away="192.168.198.28:5555"
# Add a second phone when its IP is known:
# ADB_PHONES_away="192.168.198.28:5555 192.168.198.xx:5555"

# Force profile (leave empty for auto-detect)
# ADB_PHONES_PROFILE=away

# Or set endpoints directly (overrides profiles)
# ADB_PHONES="192.168.198.28:5555"
